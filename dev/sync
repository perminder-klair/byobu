#!/bin/bash
# Brings a running panel up to date with this checkout: packages, the rootfs overlay, the shell
# and byobud builds, and this desktop's Omarchy themes. Saves building and flashing an image for
# most changes. Boot partition files (config.txt) still need a new image, and the panel's own
# settings in /etc/byobu and /var/lib/byobu are left alone.
#
#   dev/sync 192.168.1.162
# shellcheck disable=SC2029 # Remote commands are put together here on purpose.
set -euo pipefail
cd "$(dirname "$0")/.."

PANEL=root@${1:?usage: dev/sync <panel address>}
SHARE=/usr/local/share/byobu

echo "==> Building the shell and byobud"
(cd shell && pnpm -s build --logLevel warn)
(cd byobud && pnpm -s build)

# Root is read-only on a panel past its first boot, and a release installed with byobu-update
# takes priority over what's copied here, so it's removed below.
ssh "$PANEL" "mount -o remount,rw /"
trap 'ssh "$PANEL" "findmnt -no OPTIONS /data >/dev/null && mount -o remount,ro /" || true' EXIT

echo "==> Installing packages"
ssh "$PANEL" "pacman -S --needed --noconfirm $(grep -Ev '^(#|$)' builder/packages.txt | tr '\n' ' ')" 2>&1 |
  grep -vE '^(warning: .* is up to date -- skipping| there is nothing to do)$' || true

echo "==> Copying the rootfs overlay, shell and byobud"
tar -C rootfs -c --owner=root --group=root --exclude=./boot --exclude=./etc/byobu . |
  ssh "$PANEL" "tar -C / -x --no-overwrite-dir && rm -rf $SHARE/shell $SHARE/byobud && mkdir -p $SHARE/shell $SHARE/byobud $SHARE/themes"
tar -C shell/dist -c --owner=root --group=root . | ssh "$PANEL" "tar -C $SHARE/shell -x"
tar -C byobud/dist -c --owner=root --group=root . | ssh "$PANEL" "tar -C $SHARE/byobud -x"

if [[ -d ~/.local/share/omarchy/themes ]]; then
  echo "==> Copying the Omarchy themes"
  themes=${XDG_CACHE_HOME:-$HOME/.cache}/byobu/themes
  builder/export-themes ~/.local/share/omarchy/themes "$themes"
  tar -C "$themes" -c --owner=root --group=root . | ssh "$PANEL" "tar -C $SHARE/themes -x --no-overwrite-dir"
fi

omarchy=~/.local/state/omarchy/current
if [[ -f $omarchy/theme/colors.toml ]]; then
  echo "==> Copying the current Omarchy theme"
  rootfs/usr/local/bin/byobu-theme < "$omarchy/theme/colors.toml" | ssh "$PANEL" "cat > /etc/byobu/theme.css"
  magick "$omarchy/background" -resize '1280x720^' -gravity center -extent 1280x720 -strip -quality 80 jpg:- |
    ssh "$PANEL" "cat > /etc/byobu/wallpaper.jpg"
fi

echo "==> Restarting the kiosk"
ssh "$PANEL" "systemctl daemon-reload && udevadm control --reload &&
  udevadm trigger --subsystem-match=backlight --action=add &&
  systemctl enable byobu-firstboot.service byobud.service &&
  rm -f /data/app/current && systemctl restart byobud byobu-kiosk"
