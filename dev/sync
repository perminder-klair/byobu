#!/bin/bash
# Brings a running panel up to date with this checkout: packages, the rootfs overlay, the
# dashboard build and this desktop's current Omarchy theme. Saves building and flashing an
# image for most changes. Boot partition files (config.txt) still need a new image, and the
# panel's own settings in /etc/byobu are left alone.
#
#   dev/sync 192.168.1.162
# shellcheck disable=SC2029 # Remote commands are put together here on purpose.
set -euo pipefail
cd "$(dirname "$0")/.."

PANEL=root@${1:?usage: dev/sync <panel address>}
DASHBOARD=/usr/local/share/byobu/dashboard

echo "==> Building the dashboard"
(cd dashboard && pnpm -s build --logLevel warn)

echo "==> Installing packages"
ssh "$PANEL" "pacman -S --needed --noconfirm $(grep -Ev '^(#|$)' builder/packages.txt | tr '\n' ' ')" 2>&1 |
  grep -vE '^(warning: .* is up to date -- skipping| there is nothing to do)$' || true

echo "==> Copying the rootfs overlay and dashboard"
tar -C rootfs -c --owner=root --group=root --exclude=./boot --exclude=./etc/byobu . |
  ssh "$PANEL" "tar -C / -x --no-overwrite-dir && rm -rf $DASHBOARD/assets"
tar -C dashboard/dist -c --owner=root --group=root . | ssh "$PANEL" "tar -C $DASHBOARD -x --no-overwrite-dir"

colors=~/.local/state/omarchy/current/theme/colors.toml
if [[ -f $colors ]]; then
  echo "==> Copying the current Omarchy theme"
  rootfs/usr/local/bin/byobu-theme < "$colors" | ssh "$PANEL" "cat > /etc/byobu/theme.css"
fi

echo "==> Restarting the kiosk"
ssh "$PANEL" "systemctl daemon-reload && udevadm control --reload &&
  systemctl enable --now byobu-dashboard.service && systemctl restart byobu-dashboard byobu-kiosk"
