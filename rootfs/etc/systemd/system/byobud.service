# Runs the plugins and serves the shell to the kiosk, on localhost only. Settings live in
# /var/lib/byobu. See byobud/ in the source.
[Unit]
Description=Byōbu service
After=network.target byobu-config.service avahi-daemon.service user@1000.service
Wants=user@1000.service

[Service]
User=byobu
StateDirectory=byobu
StateDirectoryMode=0750
# The kiosk user's session, for PipeWire and media players. byobu is uid 1000.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/local/bin/byobud-start
Restart=always
RestartSec=2
# byobud saves as it goes, and shairport-sync can hang stopping, so what's left is killed at once.
KillMode=mixed
TimeoutStopSec=5
ProtectSystem=strict
# Rather than ProtectHome, which also hides the session in /run/user.
InaccessiblePaths=/home /root
PrivateTmp=yes
NoNewPrivileges=yes
# AF_NETLINK and AF_PACKET are how the receivers find the network interface and its address.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET

[Install]
WantedBy=graphical.target
