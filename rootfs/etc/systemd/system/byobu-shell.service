# Serves the shell to the kiosk, on localhost only. config.json, theme.css and wallpaper.jpg in
# the served directory are symlinks into /etc/byobu.
[Unit]
Description=Byōbu shell web server

[Service]
User=byobu
ExecStart=/usr/bin/darkhttpd /usr/local/share/byobu/shell --addr 127.0.0.1 --port 8080 \
  --no-listing --no-server-id --log /dev/null --header "Cache-Control: no-cache"
Restart=always
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=graphical.target
