#!/bin/bash
# Sets the panel's backlight for the shell, which as a web page can't write to /sys itself.
# systemd runs this once per connection to byobu-backlight.socket, with the connection on
# stdin and stdout:
#
#   POST /?percent=40
#
# 0 turns the backlight off.
set -euo pipefail

respond() { printf 'HTTP/1.1 %s\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n' "$1"; }

IFS=' ' read -r -t 2 _ target _ || true
while IFS= read -r -t 2 line && [[ $line != $'\r' ]]; do :; done

percent=${target#*percent=}
backlight=$(echo /sys/class/backlight/*)
if [[ ! $percent =~ ^[0-9]{1,3}$ ]] || ((10#$percent > 100)); then
  respond "400 Bad Request"
elif [[ ! -w $backlight/brightness ]]; then
  respond "503 Service Unavailable"
else
  percent=$((10#$percent))
  max=$(cat "$backlight/max_brightness")
  level=$((percent * max / 100))
  # A low percentage shouldn't round down to off.
  ((percent == 0 || level > 0)) || level=1
  echo "$level" > "$backlight/brightness"
  respond "204 No Content"
fi
