#!/bin/bash
# Runs inside cage as the byobu user: rotates the panel, then hands the screen to Chromium.

rotation=$(cat /etc/byobu/rotation 2>/dev/null)
url=$(cat /etc/byobu/url 2>/dev/null)
# Once Home Assistant is set up, the shell is the default page; until then, the touch test.
if [[ -z $url ]]; then
  if [[ -f /etc/byobu/config.json ]]; then
    url=http://localhost:8080/
  else
    url=file:///usr/local/share/byobu/test/index.html
  fi
fi

# Rotation is a property of the DSI panel; an HDMI screen plugged in for debugging stays as is.
output=$(wlr-randr | awk '/^DSI-/ { print $1; exit }')
if [[ -n $output && $rotation =~ ^(90|180|270)$ ]]; then
  wlr-randr --output "$output" --transform "$rotation"
fi

# After a power cut Chromium offers to restore the previous session. Mark the last exit clean.
prefs=$HOME/.config/chromium/Default/Preferences
if [[ -f $prefs ]]; then
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$prefs"
fi

exec chromium \
  --kiosk \
  --ozone-platform=wayland \
  --no-first-run \
  --noerrdialogs \
  --disable-session-crashed-bubble \
  --disable-features=TranslateUI \
  --disable-pinch \
  --disable-lcd-text \
  --overscroll-history-navigation=0 \
  --password-store=basic \
  "$url"
